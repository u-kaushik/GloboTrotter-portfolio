<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="630" viewBox="0 0 1200 630">
  <!-- White background -->
  <rect width="1200" height="630" fill="#ffffff"/>

  <!-- Green top bar -->
  <rect width="1200" height="6" fill="#22c55e"/>

  <!--
    Favicon icon — exact content from public/favicon.svg, scaled to 108×108
    favicon is 64×64, scale = 108/64 = 1.6875
    centered at x=600: left = 600 - 54 = 546, top = 148
  -->
  <g transform="translate(546, 148) scale(1.6875)">
    <rect width="64" height="64" rx="16" fill="#22c55e"/>
    <g transform="translate(12, 12) scale(1.6667)" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="10"/>
      <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/>
      <path d="M2 12h20"/>
    </g>
  </g>

  <!-- Wordmark -->
  <text
    x="600" y="345"
    text-anchor="middle"
    font-family="'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif"
    font-weight="900"
    font-size="96"
    letter-spacing="-2"
  ><tspan fill="#1f2937">Globo</tspan><tspan fill="#22c55e">Trotter</tspan></text>

  <!-- Tagline -->
  <text
    x="600" y="408"
    text-anchor="middle"
    font-family="'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif"
    font-weight="500"
    font-size="26"
    fill="#6b7280"
  >Your travel story, beautifully mapped.</text>

  <!-- Domain -->
  <text
    x="600" y="452"
    text-anchor="middle"
    font-family="'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif"
    font-weight="600"
    font-size="20"
    fill="#22c55e"
  >globotrottr.com</text>
</svg>
